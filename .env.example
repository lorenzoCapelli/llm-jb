# Copy to .env (not tracked by git) and adjust the values.

# Where HuggingFace downloads models/datasets/cache to. Do NOT leave this at
# the default (~/.cache/huggingface) on a shared machine: point it at a path
# with dedicated storage.
HF_HOME=/mounts/Users/cisintern/lorenzo/.cache/huggingface

# Only needed for gated models (e.g. Llama-3.2-1B-Instruct).
# HF_TOKEN=

# GPUs visible to the current process. sweep.py overrides this per run.
# CUDA_VISIBLE_DEVICES=0
